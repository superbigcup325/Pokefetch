{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "//": "pokefetch 联动 preset：先 pokefetch --logo-cache 刷新精灵，再 fastfetch --config <本文件>",
    "logo": {
        "type": "file-raw",
        "source": "~/.cache/pokefetch/logo.ans",
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "break",
        "colors"
    ]
}
